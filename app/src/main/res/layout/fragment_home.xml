<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_normal_treinta"
    tools:context=".home.HomeFragment">

    <TextView
        android:id="@+id/tvTituloUsuariosHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Usuarios"
        android:textSize="@dimen/txt_titulo"
        android:textColor="@color/color_principal"
        android:textStyle="bold"
        android:visibility="gone"/>

    <ScrollView
        android:id="@+id/svUsuarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxHeight="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloUsuariosHome"
        android:layout_marginTop="@dimen/margin_mediano"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUsuariosHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="@dimen/txt_texto"
            android:textColor="@color/black"/>

    </ScrollView>

    <TextView
        android:id="@+id/tvTituloHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svUsuarios"
        android:layout_marginTop="@dimen/margin_grande"
        android:text="Título de home"
        android:textSize="@dimen/txt_titulo"
        android:textColor="@color/color_principal"
        android:textStyle="bold"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloHome"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="25dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llContenedorFragments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

<!--        <androidx.recyclerview.widget.RecyclerView-->
<!--            android:id="@+id/rvContenedorFragments"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="0dp"-->
<!--            android:scrollbars="none"/>-->

    </ScrollView>

    <TextView
        android:id="@+id/tvNoIncidenciasHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="No tienes incidencias registradas\n¡Prueba a crear una!"
        android:gravity="center"
        android:textSize="@dimen/txt_subTitulo"
        android:textColor="@color/black"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>