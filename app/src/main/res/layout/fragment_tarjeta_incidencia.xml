<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="20dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white"
    tools:context=".home.TarjetaIncidenciaFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_mediano">

        <TextView
            android:id="@+id/tvTituloTarjetaIncidencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Título de la incidencia"
            android:textSize="@dimen/txt_subTitulo"
            android:textColor="@color/color_principal"
            android:textStyle="bold"/>

<!--        <TextView-->
<!--            android:id="@+id/tvDescripcionTarjetaIncidencia"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tvTituloTarjetaIncidencia"-->
<!--            android:layout_marginTop="@dimen/margin_mediano"-->
<!--            android:text="Descripción de la incidencia"-->
<!--            android:textColor="@color/black"/>-->

        <TextView
            android:id="@+id/tvUsuarioTarjetaIncidencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/margin_mediano"
            app:layout_constraintTop_toBottomOf="@id/tvTituloTarjetaIncidencia"
            android:text="Creador de la incidencia"
            android:textColor="@color/color_principal"
            android:textSize="@dimen/txt_texto"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.cardview.widget.CardView>